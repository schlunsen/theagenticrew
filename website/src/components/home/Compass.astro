---
// A compass rose, the Crew Member's Guide's motif (the main book has the helm).
interface Props { size?: number | string; stroke?: number; class?: string }
const { size = 24, stroke = 1.2, class: cls = '' } = Astro.props;
const pts = (n: number, r1: number, r2: number, w: number, off = 0) =>
  Array.from({ length: n }, (_, i) => {
    const a = off + (i * 2 * Math.PI) / n;
    const tip = [r1 * Math.sin(a), -r1 * Math.cos(a)];
    const l = [w * Math.sin(a - Math.PI / 2), -w * Math.cos(a - Math.PI / 2)];
    const r = [w * Math.sin(a + Math.PI / 2), -w * Math.cos(a + Math.PI / 2)];
    return `M${l[0].toFixed(2)},${l[1].toFixed(2)} L${tip[0].toFixed(2)},${tip[1].toFixed(2)} L${r[0].toFixed(2)},${r[1].toFixed(2)}`;
  });
const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * Math.PI) / 36, r2 = i % 9 === 0 ? 86 : 93;
  return { x1: (98 * Math.sin(a)).toFixed(2), y1: (-98 * Math.cos(a)).toFixed(2), x2: (r2 * Math.sin(a)).toFixed(2), y2: (-r2 * Math.cos(a)).toFixed(2) };
});
const minor = pts(8, 60, 0, 9, Math.PI / 8);
const major = pts(4, 96, 0, 14);
const majorW = stroke * 1.4;
---
<svg class={cls} width={size} height={size} viewBox="-104 -104 208 208" fill="none" stroke="currentColor" stroke-width={stroke} aria-hidden="true">
  <circle r="98" />
  <circle r="88" stroke-dasharray="1 3" />
  <circle r="62" />
  {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
  {minor.map((d) => <path d={d} />)}
  {major.map((d) => <path d={d} stroke-width={majorW} />)}
  <circle r="7" fill="currentColor" stroke="none" />
</svg>
