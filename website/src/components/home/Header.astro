---
import Helm from './Helm.astro';
// On sub-pages (e.g. /watch) the section anchors must point back to the homepage.
const { sub = false } = Astro.props as { sub?: boolean };
const h = (a: string) => (sub ? '/' + a : a);
---
<header class="home-header" data-header>
  <div class="home-header__inner">
    <a href="/" class="home-header__brand" aria-label="The Agentic Crew — home">
      <Helm size={26} stroke={5} />
      The Agentic Crew
    </a>
    <nav class="home-header__links" aria-label="Primary">
      <a href={h("#new")}>What's new</a>
      <a href={h("#chapters")}>Chapters</a>
      <a href={h("#author")}>Author</a>
      <a href={h("#listen")}>Listen</a>
      <a href="/watch">Watch</a>
      <a href="/books/crew-guide">Crew Guide</a>
      <a href="/books/hands-on">Hands-On</a>
      <a href={h("#download")} class="btn btn--brass">Read free</a>
    </nav>
    <button class="home-header__toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 5h14M2 9h14M2 13h14"/></svg>
    </button>
  </div>
</header>
<nav class="home-header__drawer" aria-label="Mobile" data-drawer>
  <a href={h("#new")}>What's new</a>
  <a href={h("#chapters")}>Chapters</a>
  <a href={h("#author")}>Author</a>
  <a href={h("#listen")}>Listen</a>
  <a href="/watch">Watch <small>A short film per chapter</small></a>
  <a href="/books/the-agentic-crew">The Agentic Crew <small>Engineering book · 4 languages</small></a>
  <a href="/books/crew-guide">Crew Member's Guide <small>For non-coders · 2 languages</small></a>
  <a href="/books/hands-on">Hands-On Guide <small>Practical exercises</small></a>
  <a href={h("#download")}>Read free</a>
</nav>
