---
import FilmPage from '../../components/watch/FilmPage.astro';
import { films, seriesOf, type Film } from '../../data/films';

export function getStaticPaths() {
  return films.map((film, i) => ({ params: { slug: film.slug }, props: { film, prev: films[i - 1], next: films[i + 1] } }));
}
const { film, prev, next } = Astro.props as { film: Film; prev?: Film; next?: Film };
---
<FilmPage film={film} prev={prev} next={next} series={seriesOf('main')} />
