---
import FilmPage from '../../../components/watch/FilmPage.astro';
import { handsonFilms, seriesOf, type Film } from '../../../data/films';

export function getStaticPaths() {
  return handsonFilms.map((film, i) => ({ params: { slug: film.slug }, props: { film, prev: handsonFilms[i - 1], next: handsonFilms[i + 1] } }));
}
const { film, prev, next } = Astro.props as { film: Film; prev?: Film; next?: Film };
---
<FilmPage film={film} prev={prev} next={next} series={seriesOf('handson')} />
