---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/home/Header.astro';
import SiteFooter from '../../components/home/SiteFooter.astro';
import Compass from '../../components/home/Compass.astro';
import CrewAudiobook from '../../components/CrewAudiobook.astro';
import { crewChapters, crewParts, newInCrewSecondEdition } from '../../data/chapters';
import '../../styles/home.css';
import '../../styles/crew.css';

const grouped = crewParts.map((p) => ({ ...p, chapters: crewChapters.slice(p.from - 1, p.to) }));

const langs = [
  { code: 'en', label: 'English', title: "Crew Member's Guide — second edition, September 2026", pdf: '/the-agentic-crew-crew.pdf', epub: '/the-agentic-crew-crew.epub' },
  { code: 'ca', label: 'Català', title: 'La Tripulació Agèntica: Guia del Tripulant — primera edició', pdf: '/the-agentic-crew-crew-ca.pdf', epub: '/the-agentic-crew-crew-ca.epub' },
];

const news = [
  { tag: 'New chapter', title: 'Hidden Instructions', body: 'When an email gives your agent orders. Prompt injection, the lethal trifecta, and a three-question check before you connect anything.' },
  { tag: 'New habit', title: 'Plan before you build', body: 'Ask the agent for a plan, and read it. The cheapest review you will ever do.' },
  { tag: 'Updated', title: 'A tidy workbench', body: 'Why long conversations get worse, when to start fresh, and writing your standing instructions down once.' },
  { tag: 'Updated', title: 'Agents that work while you’re away', body: 'Cloud agents hand back finished work. Your attention is the new bottleneck — plan around the reviewer.' },
];

const points = [
  { title: 'What agents actually are', body: 'A clear mental model for what AI agents can and can’t do — observe, plan, act, check — without the jargon.' },
  { title: 'Directing agents yourself', body: 'How to brief an agent, give it the right context, ask for a plan, and check its work. No programming required.' },
  { title: 'Working with engineering teams', body: 'Enough of how software works to follow the conversation — and ask the questions that change the outcome.' },
  { title: 'When to push back', body: 'What agents get wrong, the hidden instructions to watch for, and when to do the job yourself.' },
];

const arrow = '<svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M3 17h14"/></svg>';
const play = '<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><polygon points="6,3 6,17 17,10"/></svg>';
---

<BaseLayout
  title="The Agentic Crew: Crew Member's Guide — for people who don't write code (Second Edition)"
  description="A free guide for people who are great with computers but don't write code. Understand AI agents, direct them, stay safe from prompt injection, and build real things without programming. Second edition, September 2026."
>
  <div class="home crew-theme">
    <Header sub cta={{ label: 'Download free', href: '#download' }} />
    <main>
      <!-- Hero -->
      <section class="hero2" aria-labelledby="hero-title">
        <div class="hero2__helm" aria-hidden="true"><Compass size="100%" stroke={0.5} /></div>
        <div class="wrap">
          <div class="hero2__grid">
            <div>
              <a href="#new" class="hero2__badge"><b>New</b> Second edition · September 2026</a>
              <h1 id="hero-title" class="hero2__title crew-title">Not a programmer? <em>Welcome aboard.</em></h1>
              <p class="hero2__sub">The Agentic Crew · Crew Member's Guide</p>
              <p class="hero2__lede">
                For designers, project managers, analysts, founders — anyone who's great with computers but doesn't write code.
                What agents actually are, how modern software works under the hood, and how to direct an agent to build
                something real. Free, forever.
              </p>
              <div class="hero2__actions">
                <a href="#download" class="btn btn--brass">Download free <Fragment set:html={arrow} /></a>
                <a href="#new" class="btn btn--ghost">What's new in the 2nd edition</a>
                <a href="/crew-presentation" class="btn btn--link"><Fragment set:html={play} /> Presentation</a>
              </div>
              <ul class="hero2__facts" aria-label="At a glance">
                <li><strong>19</strong><span>chapters</span></li>
                <li><strong>0</strong><span>code required</span></li>
                <li><strong>2</strong><span>languages</span></li>
                <li><strong>€0</strong><span>always free</span></li>
              </ul>
            </div>
            <div class="hero2__book">
              <div class="cover3d">
                <img src="/book-cover-crew.png" alt="The Agentic Crew: Crew Member's Guide, second edition — cover with a brass compass rose on midnight blue" width="1748" height="2480" loading="eager" fetchpriority="high" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- What's new -->
      <section class="band band--night" id="new" aria-labelledby="new-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Second edition</span>
            <h2 id="new-title" class="h2">Six months is a <em>long time</em> in this field.</h2>
            <p class="lede">Chat assistants grew hands, agents started working in the cloud, and a new kind of risk arrived: text that gives your agent orders. This edition catches up.</p>
          </div>
          <div class="news reveal">
            {news.map((n, i) => (
              <article class="news__item">
                <span class="news__num">{['i', 'ii', 'iii', 'iv'][i]}</span>
                <span class="news__tag">{n.tag}</span>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Who it's for -->
      <section class="band band--paper" id="about" aria-labelledby="about-title">
        <div class="wrap">
          <div class="shift">
            <figure class="shift__plate reveal">
              <div class="shift__plate-frame">
                <img src="/illustrations/crew/ch01-welcome.jpg" alt="A person at a ship's railing looking out at a wide horizon" width="1024" height="768" loading="lazy" />
              </div>
              <figcaption>The horizon is wider than you think.</figcaption>
            </figure>
            <div class="reveal">
              <span class="eyebrow">Who it's for</span>
              <h2 id="about-title" class="h2">Everyone on <em>the crew.</em></h2>
              <p class="lede">
                You manage systems, wrangle data, and fix the Wi-Fi for your whole family — but you've never written a line of code.
                This guide covers the same ground as the engineering book, translated for people who think in outcomes, not implementations.
              </p>
              <ul class="shift__points">
                {points.map((p, i) => (
                  <li>
                    <span>{['i', 'ii', 'iii', 'iv'][i]}</span>
                    <div><h3>{p.title}</h3><p>{p.body}</p></div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Chapters -->
      <section class="band band--night" id="chapters" aria-labelledby="chapters-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">What's inside</span>
            <h2 id="chapters-title" class="h2">The voyage, <em>chapter by chapter.</em></h2>
            <p class="lede">Nineteen chapters in five parts — from what an agent really is to building a working app in a weekend.</p>
          </div>
          {grouped.map((p) => (
            <div class="part reveal">
              <div class="part__head">
                <div class="part__numeral">{p.numeral}</div>
                <h3 class="part__title">{p.title}</h3>
                <p class="part__sub">{p.subtitle}</p>
              </div>
              <ol class="chap-list">
                {p.chapters.map((c) => (
                  <li class="chap">
                    <span class="chap__num">{c.number}</span>
                    <div>
                      <h3>{c.title}{newInCrewSecondEdition.has(c.title) && <span class="pill">New</span>}</h3>
                      <p>{c.description}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <!-- Presentations -->
      <section class="band band--ink" id="watch" aria-labelledby="watch-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Watch</span>
            <h2 id="watch-title" class="h2">Prefer to <em>watch?</em></h2>
            <p class="lede">Short narrated slideshows that cover the core ideas — no reading required.</p>
          </div>
          <div class="news news--two reveal">
            <a class="news__item news__link" href="/crew-presentation">
              <span class="news__tag">Non-technical</span>
              <h3>Crew presentation</h3>
              <p>Designed for people who don't write code — what agents are, what they can do, and how to work alongside them.</p>
              <span class="news__cta"><Fragment set:html={play} /> Watch now</span>
            </a>
            <a class="news__item news__link" href="/presentation">
              <span class="news__tag">For engineers</span>
              <h3>Engineering presentation</h3>
              <p>The full technical version — context, guardrails, multi-agent workflows, and agents in CI/CD.</p>
              <span class="news__cta"><Fragment set:html={play} /> Watch now</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Download -->
      <section class="band band--night" id="download" aria-labelledby="dl-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Free download</span>
            <h2 id="dl-title" class="h2">Take it <em>aboard.</em></h2>
            <p class="lede">No sign-up, no email wall. PDF for reading at a desk, EPUB for e-readers.</p>
          </div>
          <div class="dl">
            <div class="dl__card reveal" data-downloads>
              <div class="dl__langs" role="group" aria-label="Language">
                {langs.map((l, i) => (
                  <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-lang={l.code} data-title={l.title} data-pdf={l.pdf} data-epub={l.epub}>{l.label}</button>
                ))}
              </div>
              <p class="dl__edition" data-edition>{langs[0].title}</p>
              <div class="dl__formats">
                <a class="dl__format" href={langs[0].pdf} download data-fmt="pdf">
                  <b>PDF</b>
                  <strong>Print layout <Fragment set:html={arrow} /></strong>
                  <span>Desktop and tablet. Full typesetting.</span>
                </a>
                <a class="dl__format" href={langs[0].epub} download data-fmt="epub">
                  <b>EPUB</b>
                  <strong>E-reader <Fragment set:html={arrow} /></strong>
                  <span>Reflowable for Kindle, Kobo, iPad.</span>
                </a>
              </div>
              <p class="dl__note">The Catalan translation follows the first edition. Past versions live in the <a href="/revisions/">revision archive</a>.</p>
            </div>
            <div class="series reveal">
              <p class="series__label">More from the series</p>
              <a class="series__card" href="/books/the-agentic-crew">
                <img src="/book-cover-2e.png" alt="" loading="lazy" />
                <div><h3>The Agentic Crew</h3><p>The engineering edition. For people who write code — 19 chapters, 4 languages.</p></div>
              </a>
              <a class="series__card" href="/books/hands-on">
                <div class="series__cover" aria-hidden="true">Hands-On Guide</div>
                <div><h3>Hands-On Guide</h3><p>Exercises for your own machine: fork, build, ship, and pentest with an agent.</p></div>
              </a>
              <div class="coffee">
                <p>Free, forever. If it helped, a coffee keeps the ship sailing.</p>
                <a class="btn btn--ghost" href="https://buymeacoffee.com/schlunsen" target="_blank" rel="noopener">Buy me a coffee</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Listen -->
      <section class="band band--paper" id="listen" aria-labelledby="listen-title">
        <div class="wrap">
          <div class="section-head section-head--center reveal">
            <span class="eyebrow">Listen free</span>
            <h2 id="listen-title" class="h2">Hear it <em>on watch.</em></h2>
            <p class="lede">AI-narrated, chapter by chapter. The audiobook currently narrates the first edition.</p>
          </div>
        </div>
        <div class="listen-host">
          <CrewAudiobook />
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  /* The crew title is a sentence, not a name: a touch smaller than the homepage wordmark. */
  .home :global(.crew-title) { font-size: clamp(2.8rem, 6.6vw, 5.4rem); line-height: 0.98; }
  .home :global(.crew-title em) { display: block; }
  .home :global(.news--two) { grid-template-columns: 1fr 1fr; }
  .home :global(.news__link) { text-decoration: none; display: flex; flex-direction: column; }
  .home :global(.news__cta) {
    margin-top: 1.2rem; display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass);
  }
  .home :global(.news__link:hover .news__cta) { color: var(--brass-light); }
  @media (max-width: 560px) { .home :global(.news--two) { grid-template-columns: 1fr; } }
</style>

<script>
  function initCrewGuide() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    // Header: solid on scroll, mobile drawer
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const drawer = document.querySelector<HTMLElement>('[data-drawer]');
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    // Download language switcher
    const dl = document.querySelector<HTMLElement>('[data-downloads]');
    if (dl) {
      const buttons = Array.from(dl.querySelectorAll<HTMLButtonElement>('[data-lang]'));
      const edition = dl.querySelector<HTMLElement>('[data-edition]');
      const pdf = dl.querySelector<HTMLAnchorElement>('[data-fmt="pdf"]');
      const epub = dl.querySelector<HTMLAnchorElement>('[data-fmt="epub"]');
      buttons.forEach((b) => b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        if (edition) edition.textContent = b.dataset.title ?? '';
        if (pdf && b.dataset.pdf) pdf.href = b.dataset.pdf;
        if (epub && b.dataset.epub) epub.href = b.dataset.epub;
      }));
    }

    // Reveal on scroll
    const els = document.querySelectorAll('.home .reveal');
    if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('is-in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    els.forEach((el) => io.observe(el));
  }
  document.addEventListener('astro:page-load', initCrewGuide);
</script>
