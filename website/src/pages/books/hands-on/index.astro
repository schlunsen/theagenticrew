---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/home/Header.astro';
import SiteFooter from '../../../components/home/SiteFooter.astro';
import Blueprint from '../../../components/home/Blueprint.astro';
import '../../../styles/home.css';
import '../../../styles/hands-on.css';

// ── Films (coming) ──
// The Watch section renders only when src/data/films-handson.json exists and is non-empty.
// Expected shape (the same fields as films.json, written by the video pipeline):
//   [{ id: "01", slug: "setting-up-your-workstation", title: "Setting Up Your Workstation",
//      duration: 312.4,                       // seconds
//      video: "/films/hands-on/….mp4", poster: "/films/hands-on/….jpg", captions: "/films/hands-on/….vtt",
//      transcript: ["paragraph", "paragraph", …] }]
// import.meta.glob keeps the build working while the file doesn't exist yet.
interface HandsOnFilm { id: string; slug: string; title: string; duration: number; video: string; poster: string; captions: string; transcript: string[] }
const filmModules = import.meta.glob<{ default: HandsOnFilm[] }>('../../../data/films-handson.json', { eager: true });
const films: HandsOnFilm[] = Object.values(filmModules)[0]?.default ?? [];
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, '0')}`;

// The ten exercises: short card copy, and the fuller description for the contents list.
const exercises = [
  { num: '01', slug: 'setting-up-your-workstation', title: 'Setting Up Your Workstation', img: '/illustrations/ho-setup.jpg',
    card: 'Terminal, package manager, Git, GitHub CLI, Node.js, and an AI coding agent — Claude Code or Antigravity CLI — from scratch, on any OS.',
    desc: 'Terminal, package manager, Git, GitHub CLI, Node.js, and optionally an AI coding agent (Claude Code or Antigravity CLI), installed from official sources. Each edition is tailored to your OS. Ends with a verified connection to GitHub and an agent that asks before it acts.' },
  { num: '02', slug: 'your-first-pull-request', title: 'Your First Pull Request', img: '/illustrations/ho-pr.jpg',
    card: 'Fork a real repository, write a review, read your diff, commit and push, and submit a pull request that goes live on GitHub.',
    desc: 'Fork a real repository, read a chapter, write a review, check the diff before you commit, push, and submit a pull request that goes live on GitHub. Optionally let an agent drive the Git steps — from a plan you approve first.' },
  { num: '03', slug: 'your-first-ai-project', title: 'Your First AI-Generated Project', img: '/illustrations/ho-aiproject.jpg',
    card: 'Fork the web-presenter project and have an AI agent generate illustrations via Hugging Face, MP3 narration with edge-tts, and a recoloured animated background — all from prompts.',
    desc: 'Fork the web-presenter project and have an AI agent adapt its asset script: FLUX illustrations via Hugging Face (free monthly credit), MP3 narration via edge-tts, and a recoloured Three.js background. Your token stays in an environment variable, and you review each diff before anything runs.' },
  { num: '04', slug: 'pair-programming-with-an-agent', title: 'Pair Programming with an Agent', img: '/illustrations/ho-pairprog.jpg',
    card: 'Build a Travel Bucket List web app from an AGENTS.md of house rules and an approved plan — reviewing every change as a diff, without writing a line of code yourself.',
    desc: 'Write the house rules in an AGENTS.md, agree a plan in plan mode, and let the agent build a Travel Bucket List with full CRUD and localStorage. Review each change as a git diff, commit step by step, and push it to a new GitHub repository.' },
  { num: '05', slug: 'going-live', title: 'Going Live', img: '/illustrations/ho-golive.jpg',
    card: 'Deploy your app to a Hetzner VPS — the agent SSHes in and calls the Cloudflare API for DNS, while you approve every destructive command.',
    desc: 'Deploy your Travel Bucket List to a Hetzner CX23 server (about EUR 5–7 a month). Your agent operates it over SSH — hardening it with a non-root deploy user, setting up Caddy with automatic HTTPS and a systemd service — and creates DNS records via the Cloudflare API with a narrowly scoped token. You approve every destructive command.' },
  { num: '06', slug: 'pentesting-with-an-agent', title: 'Pentesting with an Agent', img: '/illustrations/ho-pentest.jpg',
    card: 'Attack your own app before anyone else does. Shannon, an open-source AI pentester, runs recon, source analysis, exploitation, and reporting against an app you own.',
    desc: 'Attack your own application before anyone else does. Run Shannon — an open-source (AGPL) AI pentesting agent — against a practice target and then your own app: a full scan takes about an hour to an hour and a half. Verify the findings by hand, and treat the scanned app and the report as untrusted input.' },
  { num: '07', slug: 'testing-as-a-safety-net', title: 'Testing as a Safety Net', img: '/illustrations/ho-testing.jpg',
    card: 'Give the agent eyes. Write end-to-end tests with Playwright, tell the agent how to check its work, practise TDD, and set up least-privilege CI — so no change ships unchecked.',
    desc: 'Give the agent eyes. Install Playwright, write end-to-end tests by describing behaviours in English, add an instruction file that tells the agent how to check its own work, practise TDD with an agent, and set up GitHub Actions CI with read-only permissions and an uploaded test report.' },
  { num: '08', slug: 'the-agentic-pipeline', title: 'The Agentic Pipeline', img: '/illustrations/ho-pipeline.jpg',
    card: 'Tool-less, schema-constrained agents turn raw feedback into triaged issue drafts and a weekly report. A plain script files the issues — after you approve them.',
    desc: 'Build a pipeline of headless agents with no tools and JSON-schema output: raw feedback goes in, triaged issue drafts and a weekly report come out. A plain script files the issues after human review (or in GitHub Actions after an approval step). A hostile feedback entry teaches prompt injection, and every call has a cost cap.' },
  { num: '09', slug: 'your-own-saas', title: 'Your Own SaaS', contentsTitle: 'Your Own SaaS — From Idea to Launch in a Day', img: '/illustrations/ho-saas.jpg',
    card: 'The capstone. Brief the agent with an AGENTS.md and build a micro-SaaS plan-first — Next.js, Better Auth, Stripe subscriptions, the Claude API, CI — then ship it to a live URL.',
    desc: 'The capstone. Build a micro-SaaS with Next.js, Better Auth, Stripe subscriptions in the sandbox, and an AI feature on the Claude API. Brief the agent with an AGENTS.md, build plan-first, test in CI, and deploy to your own VPS behind Caddy or to Railway.' },
  { num: '10', slug: 'captains-log', title: "Captain's Log", img: '/illustrations/ho-captainslog.jpg',
    card: 'Write an AGENTS.md that any agent follows, promote one must-never-happen rule into a permission rule or hook, and take the helm.',
    desc: 'The finale. Reflect on the journey, write an AGENTS.md (with a one-line CLAUDE.md pointer) that any agent follows on your own project, promote one must-never-happen rule into a permission rule or hook, and set sail on your maiden voyage.' },
];

// What you'll actually do — each with a short terminal-style token in place of an icon.
const highlights = [
  { tok: '$_', title: 'Run real commands', body: 'Every step uses actual terminal commands — <code>git</code>, <code>gh</code>, <code>python3</code>. No web interfaces, no drag-and-drop.' },
  { tok: 'gh', title: 'Work with live GitHub repos', body: 'You’ll fork <code>schlunsen/theagenticcrew</code> and <code>schlunsen/web-presenter</code> — real projects with real histories.' },
  { tok: 'img', title: 'Generate AI illustrations', body: 'Use FLUX via Hugging Face Inference Providers to generate ten custom images for your presentation — covered by the free monthly credit, with your token kept in an environment variable.' },
  { tok: 'tts', title: 'Generate AI narration', body: 'Turn your slide text into MP3 narration with <code>edge-tts</code> — free, no account or key needed, no recording required.' },
  { tok: 'fx', title: 'Customise animated backgrounds', body: 'Ask an AI agent to change the Three.js network animation to match your presentation’s colour palette — in seconds.' },
  { tok: 'pair', title: 'Pair-program with an AI agent', body: 'Write the house rules in <code>AGENTS.md</code>, approve a plan, and let the agent build a Travel Bucket List — reviewing every change as a <code>git diff</code> and committing step by step.' },
  { tok: 'ssh', title: 'Deploy to a real server', body: 'Your agent SSHes into a Hetzner VPS, configures Caddy with auto-HTTPS, and calls the Cloudflare API for DNS — while you approve every destructive command.' },
  { tok: 'sec', title: 'Pentest with AI agents', body: 'Shannon probes an app you own for SQL injection, XSS, auth bypasses, and more — then writes a professional security report with CVSS scores that you verify by hand.' },
  { tok: 'tdd', title: 'Write tests with TDD', body: 'Describe behaviours in plain English, let the agent write Playwright tests, then experience the red-green-refactor loop — breaking things on purpose and watching the agent fix them.' },
  { tok: 'cron', title: 'Automate with pipelines', body: 'Chain tool-less, schema-constrained agents into a shell pipeline. Raw feedback goes in; triaged issue drafts and a weekly report come out — and nothing is filed until you approve it.' },
  { tok: '$$$', title: 'Ship a SaaS product', body: 'Build a micro-SaaS plan-first — Better Auth, Stripe subscriptions, the Claude API, CI, and a landing page. Deployed to a live URL you can text to a friend.' },
  { tok: 'push', title: 'Ship it to GitHub', body: 'Every exercise ends with a commit and push. Your work lives on GitHub — shareable, versioned, real.' },
];

const langs = [
  { code: 'en', label: 'English', title: 'hands-on-guide --lang=en · pick your OS', os: [
    { name: 'Windows', pdf: '/the-agentic-crew-hands-on-windows.pdf', body: 'PowerShell, WinGet, and Windows-specific commands throughout.' },
    { name: 'macOS', pdf: '/the-agentic-crew-hands-on-mac.pdf', body: 'Terminal, Homebrew, and macOS-specific commands throughout.' },
    { name: 'Linux', pdf: '/the-agentic-crew-hands-on-linux.pdf', body: 'Ubuntu-based examples with apt, adaptable to any distribution.' },
  ] },
  { code: 'es', label: 'Español', title: 'hands-on-guide --lang=es · elige tu sistema', os: [
    { name: 'Windows', pdf: '/the-agentic-crew-hands-on-es-windows.pdf', body: 'PowerShell, WinGet y comandos específicos para Windows.' },
    { name: 'macOS', pdf: '/the-agentic-crew-hands-on-es-mac.pdf', body: 'Terminal, Homebrew y comandos específicos para macOS.' },
    { name: 'Linux', pdf: '/the-agentic-crew-hands-on-es-linux.pdf', body: 'Ejemplos basados en Ubuntu con apt, adaptables a cualquier distribución.' },
  ] },
];

const arrow = '<svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M3 17h14"/></svg>';
const play = '<svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><polygon points="6,3 6,17 17,10"/></svg>';
---

<BaseLayout
  title="The Agentic Crew: Hands-On Guide — Learn by Doing"
  description="A free practical exercise book. Set up your machine, fork a real repo, submit a pull request, and build an AI-generated presentation — all from a terminal."
>
  <div class="home handson-theme">
    <Header sub cta={{ label: 'Download free', href: '#download' }} />
    <main>
      <!-- Hero -->
      <section class="hero2" aria-labelledby="hero-title">
        <div class="ho-sheet" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>A</span><span>B</span></div>
        <div class="wrap">
          <div class="hero2__grid">
            <div>
              <a href="#exercises" class="hero2__badge"><b>10</b> exercises · Windows, macOS &amp; Linux</a>
              <p class="ho-prompt" aria-hidden="true"><b>$</b> open hands-on-guide <i>--os=yours</i><span class="caret"></span></p>
              <h1 id="hero-title" class="hero2__title">Learn by doing, <em>not by reading.</em></h1>
              <p class="hero2__sub">The Agentic Crew · Hands-On Guide</p>
              <p class="hero2__lede">
                Each chapter is an exercise, not an explanation. You'll set up a real development
                environment, submit a pull request to a live repository, pair-program a web app with an
                AI agent, deploy it to a real server, pentest it with autonomous AI security agents,
                build automated pipelines, and ship your own SaaS product — all from a terminal,
                all without prior coding experience.
              </p>
              <div class="hero2__actions">
                <a href="#download" class="btn btn--brass">Download free <Fragment set:html={arrow} /></a>
                <a href="#exercises" class="btn btn--ghost">Browse the exercises</a>
                {films.length > 0 && <a href="#watch" class="btn btn--link"><Fragment set:html={play} /> Watch</a>}
              </div>
              <ul class="hero2__facts" aria-label="At a glance">
                <li><strong>10</strong><span>exercises</span></li>
                <li><strong>Real</strong><span>repositories</span></li>
                <li><strong>3</strong><span>OS editions</span></li>
                <li><strong>Free</strong><span>forever</span></li>
              </ul>
            </div>
            <div class="hero2__book">
              <div class="ho-drawing" aria-hidden="true"><Blueprint size="100%" stroke={1} labels={false} /></div>
              <div class="cover3d">
                <img src="/book-cover-hands-on.png" alt="The Agentic Crew: Hands-On Guide — cover: a ship's wheel drawn as a blueprint with dimension lines and a title block" width="1165" height="1654" loading="eager" fetchpriority="high" />
              </div>
              <div class="ho-dim ho-dim--w" aria-hidden="true"><span>148 mm · A5</span></div>
              <div class="ho-dim ho-dim--h" aria-hidden="true"><span>210 mm</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- What's inside -->
      <section class="band band--paper" id="exercises" aria-labelledby="inside-title">
        <div class="wrap">
          <div class="ho-inside">
            <div class="ho-inside__intro reveal">
              <span class="eyebrow">What's inside</span>
              <h2 id="inside-title" class="h2">Ten hands-on <em>exercises.</em></h2>
              <p>
                The Hands-On Guide is the practical companion to the main engineering book.
                Where the main book explains the ideas, this one puts them into practice.
              </p>
              <p>
                You don't need to be a programmer. You need to be willing to type commands
                into a terminal and see what happens. That's how you learn this — not by
                reading, but by doing.
              </p>
              <ul class="ho-spec" aria-label="Specification">
                <li><span>Format</span><b>10 exercises, 1 terminal</b></li>
                <li><span>Editions</span><b>Windows · macOS · Linux</b></li>
                <li><span>Languages</span><b>English · Español</b></li>
                <li><span>Prerequisites</span><b>None. Curiosity.</b></li>
                <li><span>Edition</span><b>2nd · September 2026</b></li>
              </ul>
            </div>
            <div class="ho-cards reveal">
              {exercises.map((e) => (
                <a href={`/books/hands-on/${e.slug}`} class="ho-card">
                  <div class="ho-card__img">
                    <img src={e.img} alt="" width="512" height="512" loading="lazy" />
                    <span class="ho-card__num">EX.{e.num}</span>
                  </div>
                  <h3>{e.title}</h3>
                  <p>{e.card}</p>
                  <span class="ho-card__go">Open exercise →</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Contents -->
      <section class="band band--night bp-grid" id="contents" aria-labelledby="contents-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Contents</span>
            <h2 id="contents-title" class="h2">10 exercises — <em>from zero to shipping.</em></h2>
          </div>
          <div class="ho-term reveal">
            <div class="ho-term__bar" aria-hidden="true"><i></i><i></i><i></i><span>~/hands-on-guide/exercises</span></div>
            <p class="ho-term__cmd" aria-hidden="true"><b>$</b> ls exercises/</p>
            <ol class="ho-rows">
              {exercises.map((e) => (
                <li class="ho-row">
                  <a href={`/books/hands-on/${e.slug}`}>
                    <span class="ho-row__num">{e.num}</span>
                    <div>
                      <strong>{e.contentsTitle ?? e.title}</strong>
                      <p>{e.desc}</p>
                    </div>
                    <span class="ho-row__go" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- Exercise highlights -->
      <section class="band band--paper" id="highlights" aria-labelledby="hl-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Exercise highlights</span>
            <h2 id="hl-title" class="h2">What you'll <em>actually do.</em></h2>
          </div>
          <div class="ho-highlights reveal">
            {highlights.map((h) => (
              <div class="ho-hl">
                <span class="ho-hl__tok" aria-hidden="true">{h.tok}</span>
                <div>
                  <h3>{h.title}</h3>
                  <p set:html={h.body} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Watch (renders once src/data/films-handson.json has films) -->
      {films.length > 0 && (
        <section class="band band--ink bp-grid" id="watch" aria-labelledby="watch-title">
          <div class="wrap">
            <div class="section-head reveal">
              <span class="eyebrow">Watch</span>
              <h2 id="watch-title" class="h2">See it <em>on the bench.</em></h2>
              <p class="lede">Short films that walk through the exercises. Made by AI agents, steered by the author.</p>
            </div>
            <div class="ho-films">
              {films.map((f) => (
                <article class="ho-film reveal" id={`film-${f.slug}`}>
                  <div class="ho-film__frame">
                    <video controls preload="none" playsinline poster={f.poster}>
                      <source src={f.video} type="video/mp4" />
                      <track kind="captions" src={f.captions} srclang="en" label="English" default />
                    </video>
                  </div>
                  <div class="ho-film__meta">
                    <h3>{f.title}</h3>
                    <span>{mmss(f.duration)}</span>
                  </div>
                  {f.transcript?.length > 0 && (
                    <details>
                      <summary>Transcript</summary>
                      {f.transcript.map((p) => <p>{p}</p>)}
                    </details>
                  )}
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Download -->
      <section class="band band--night" id="download" aria-labelledby="dl-title">
        <div class="wrap">
          <div class="section-head reveal">
            <span class="eyebrow">Free download</span>
            <h2 id="dl-title" class="h2">Get <em>the guide.</em></h2>
            <p class="lede">Pick your operating system. Available in English and Spanish.</p>
          </div>
          <div class="dl">
            <div class="dl__card reveal" data-downloads>
              <div class="dl__langs" role="group" aria-label="Language">
                {langs.map((l, i) => (
                  <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-lang={l.code} data-title={l.title}>{l.label}</button>
                ))}
              </div>
              <p class="dl__edition" data-edition>{langs[0].title}</p>
              {langs.map((l, i) => (
                <div class="ho-os" data-panel={l.code} hidden={i !== 0} lang={l.code}>
                  {l.os.map((o) => (
                    <a class="dl__format" href={o.pdf} download>
                      <b>PDF</b>
                      <strong>{o.name} <Fragment set:html={arrow} /></strong>
                      <span>{o.body}</span>
                    </a>
                  ))}
                </div>
              ))}
              <p class="dl__note">The lab companion to the engineering and crew books.</p>
            </div>
            <div class="series reveal">
              <p class="series__label">The full series</p>
              <a class="series__card" href="/books/the-agentic-crew">
                <img src="/book-cover-2e.png" alt="" loading="lazy" />
                <div><h3>The Agentic Crew</h3><p>The engineering book — 19 chapters, 4 languages.</p></div>
              </a>
              <a class="series__card" href="/books/crew-guide">
                <img src="/book-cover-crew.png" alt="" loading="lazy" />
                <div><h3>Crew Member's Guide</h3><p>For non-coders — 2 languages.</p></div>
              </a>
              <div class="coffee">
                <p>Free, forever. If it helped, a coffee keeps the workshop lights on.</p>
                <a class="btn btn--ghost" href="https://buymeacoffee.com/schlunsen" target="_blank" rel="noopener">Buy me a coffee</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  function initHandsOn() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header) return;

    // Header: solid on scroll, mobile drawer
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const drawer = document.querySelector<HTMLElement>('[data-drawer]');
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    // Download language switcher: shows that language's three OS editions
    const dl = document.querySelector<HTMLElement>('[data-downloads]');
    if (dl) {
      const buttons = Array.from(dl.querySelectorAll<HTMLButtonElement>('[data-lang]'));
      const panels = Array.from(dl.querySelectorAll<HTMLElement>('[data-panel]'));
      const edition = dl.querySelector<HTMLElement>('[data-edition]');
      buttons.forEach((b) => b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        panels.forEach((p) => { p.hidden = p.dataset.panel !== b.dataset.lang; });
        if (edition) edition.textContent = b.dataset.title ?? '';
      }));
    }

    // Reveal on scroll
    const els = document.querySelectorAll('.home .reveal');
    if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('is-in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    els.forEach((el) => io.observe(el));
  }
  document.addEventListener('astro:page-load', initHandsOn);
</script>
