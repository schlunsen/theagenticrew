---
import BaseLayout from '../layouts/BaseLayout.astro';
import Listen from '../components/Listen.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Crew Member's Guide — Audiobook | The Agentic Crew" description="Listen to the Crew Member's Guide audiobook for free. AI-narrated in English and Catalan.">
  <Nav />
  <main class="crew-audiobook-page">
    <header class="crew-audiobook-head">
      <p>Listen free</p>
      <h1>Crew Member's Guide — Audiobook</h1>
      <span>The whole guide, chapter by chapter. AI-narrated in English (two voices) and Catalan.</span>
    </header>
    <Listen books={['crew']} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .crew-audiobook-head { text-align: center; max-width: 640px; margin: 0 auto 2rem; padding: 0 1rem; }
  .crew-audiobook-head p { font-family: 'JetBrains Mono', monospace; font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; color: #8a6a1c; margin: 0; }
  .crew-audiobook-head h1 { font-family: 'Fraunces', Georgia, serif; font-weight: 400; font-size: clamp(1.9rem, 4vw, 2.6rem); margin: .5rem 0; }
  .crew-audiobook-head span { color: #5c5647; }
  .crew-audiobook-page {
    padding: 6rem 1rem 3rem;
    min-height: 80vh;
  }
</style>
